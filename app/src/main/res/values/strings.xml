<resources>
    <!-- General -->

    <!-- Application name -->
    <string name="app_name" translatable="false">Mowicons</string>
    <!-- Accessibility label for Back button -->
    <string name="back">Back</string>

    <!-- Search bar -->

    <!-- The hint shown in the search bar, with %d as the number of icons. -->
    <!-- We don't currently provide a singular form, because it's always guaranteed that there will be at least 2 or more icons. -->
    <string name="search_bar_hint">Search through %d icons</string>
    <!-- Hint shown in the search bar when picking an icon for a specific app -->
    <string name="search_bar_icon_picker">Pick an icon</string>

    <!-- Accessibility label for the search icon -->
    <string name="search">Search</string>
    <!-- Accessibility label for the clear search button -->
    <string name="clear">Clear</string>

    <!-- Text shown when there are no search results, with %s as the search query -->
    <string name="no_items_found">%s not found</string>

    <!-- Toolbar actions -->

    <!-- GitHub repository link-->
    <string name="github" translatable="false">GitHub</string>

    <!-- Label for the About screen and toolbar action -->
    <string name="about">About</string>

    <!-- Label for the installed apps screen and toolbar action -->
    <string name="apps">Apps</string>

    <!-- Title of the installed apps screen, which shows the painted icons of the apps -->
    <string name="painted_apps">Painted Apps</string>

    <!-- Label for the toggle which turns the color picker of the apps screen on and off -->
    <string name="change_color">Change color</string>

    <!-- Exporting the painted icons as an icon pack -->

    <!-- Accessibility label for the button which exports the painted icons -->
    <string name="export_painted_icons">Export painted icons</string>

    <!-- Title of the confirmation shown before exporting the painted icons -->
    <string name="export_painted_icons_title">Export painted icons?</string>

    <!-- Text of the confirmation shown before exporting the painted icons -->
    <string name="export_painted_icons_text">This builds an icon pack with the painted icons of the %1$d covered apps and saves it as an APK file, which can then be installed and selected as an icon pack in your launcher.</string>

    <!-- Button which confirms the export of the painted icons -->
    <string name="export">Export</string>

    <!-- Button which dismisses the export confirmation -->
    <string name="cancel">Cancel</string>

    <!-- Button which opens the exported icon pack, so that it can be installed -->
    <string name="install">Install</string>

    <!-- Snackbar content shown while the icon pack is being built -->
    <string name="export_painted_icons_building">Building the icon pack…</string>

    <!-- Snackbar content shown when the icon pack was saved, with the name of the file -->
    <string name="export_painted_icons_saved">Saved %1$s</string>

    <!-- Button which dismisses the result of the export -->
    <string name="ok">OK</string>

    <!-- Snackbar content shown when the icon pack could not be built, with the reason -->
    <string name="export_painted_icons_failed">Could not export the icons: %1$s</string>

    <!-- Contributors section of About page -->

    <!-- Contributors label -->
    <string name="contributors">Contributors</string>
    <!-- Core Contributors label -->
    <string name="core_contributors">Lawnicons core contributors</string>
    <!-- Item that links to the Contributors page -->
    <string name="see_all_contributors">See all Lawnicons contributors</string>

    <!-- Subtitles below users who contributed to the app -->

    <!-- Label for core app code contributions -->
    <string name="contribution_core">Core app</string>
    <!-- Label for icon contributions -->
    <string name="contribution_icons">Icons</string>
    <!-- Label for infrastructure contributions -->
    <string name="contribution_infra">Infrastructure</string>

    <!-- Special thanks section of About screen -->

    <!-- Special thanks label -->
    <string name="special_thanks">Lawnicons special thanks</string>
    <!-- Subtitle displayed below the user who inspired the app icon -->
    <string name="special_thanks_icon">For inspiring the app icon</string>
    <!-- Subtitle displayed below the user who named the app -->
    <string name="special_thanks_name">For naming the app</string>

    <!-- List item that links to the Acknowledgements page -->
    <string name="acknowledgements">Acknowledgements</string>

    <!-- Icon information popup sheet -->

    <!-- Label for the icon name -->
    <string name="name">Name</string>
    <!-- Label for the drawable resource name -->
    <string name="drawable">Drawable</string>
    <!-- Label for the component ID -->
    <string name="component">ID</string>

    <!-- Title for the section showing IDs mapped to an icon -->
    <string name="mapped_components">Mapped IDs</string>
    <!-- Outdated icon info warning -->
    <string name="icon_info_outdated_warning">If the icon is outdated due to rebranding, create an issue on GitHub.</string>

    <!-- Label for the action to view the icon's source on GitHub -->
    <string name="view_on_github">View on GitHub</string>
    <!-- Share button on icon info popup -->
    <string name="share">Share details</string>

    <!-- Toast message shown when text is copied to the clipboard -->
    <string name="copied_text">Copied text</string>
</resources>
